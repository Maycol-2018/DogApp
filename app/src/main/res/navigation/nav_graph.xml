<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dogapp.view.fragment.LoginFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeAdminFragment"
            app:destination="@id/homeAdminFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeAdminFragment"
        android:name="com.example.dogapp.view.fragment.HomeAdminFragment"
        android:label="@string/home_admin_title"
        tools:layout="@layout/fragment_home_admin">
        <action
            android:id="@+id/action_homeAdminFragment_to_newAppointmentFragment"
            app:destination="@id/newAppointmentFragment" />
        <action
            android:id="@+id/action_homeAdminFragment_to_appointmentDetailFragment"
            app:destination="@id/appointmentDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/newAppointmentFragment"
        android:name="com.example.dogapp.view.fragment.NewAppointmentFragment"
        android:label="@string/new_appointment_placeholder_title"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/appointmentDetailFragment"
        android:name="com.example.dogapp.view.fragment.AppointmentDetailFragment"
        android:label="@string/appointment_detail_placeholder_title"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="appointmentId"
            app:argType="long" />
    </fragment>
</navigation>
