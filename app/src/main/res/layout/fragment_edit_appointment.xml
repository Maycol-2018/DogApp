<?xml version="1.0" encoding="utf-8"?>
<!-- (Joel) HU5: pantalla "Editar Cita". Mismo diseño que "Nueva Cita" (barra oscura arriba y formulario debajo),
     pero sin la lista de síntomas: la HU5 solo permite editar nombre, raza, propietario y teléfono. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".view.fragment.EditAppointmentFragment">

    <!-- Barra superior: fondo oscuro con esquinas de abajo redondeadas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_appointment_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_form_toolbar"
        android:elevation="2dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Flecha rosada: vuelve al Detalle de la Cita -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_appointment_back_description"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/fab_pink" />

        <!-- Título "Editar Cita" centrado -->
        <TextView
            android:id="@+id/edit_appointment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_appointment_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/back_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/back_button" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Zona desplazable con el formulario -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_appointment_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Nombre de la mascota (máx. 15 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pet_name_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_appointment_pet_name_hint"
                android:textColorHint="@color/hint_gray"
                app:boxStrokeColor="@color/purple_500"
                app:hintTextColor="@color/purple_500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pet_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="15"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Raza: AutoCompleteTextView con las razas de la API (sugiere desde la 2da letra) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/breed_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/new_appointment_breed_hint"
                android:textColorHint="@color/hint_gray"
                app:boxStrokeColor="@color/purple_500"
                app:hintTextColor="@color/purple_500">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/breed_input"
                    style="@style/Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="2"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nombre del propietario (máx. 30 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/owner_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/new_appointment_owner_hint"
                android:textColorHint="@color/hint_gray"
                app:boxStrokeColor="@color/purple_500"
                app:hintTextColor="@color/purple_500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/owner_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="30"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Teléfono (solo números, máx. 10 dígitos) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/phone_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/new_appointment_phone_hint"
                android:textColorHint="@color/hint_gray"
                app:boxStrokeColor="@color/purple_500"
                app:hintTextColor="@color/purple_500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="10"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón "Editar Cita": rosado, redondeado, icono a la izquierda.
                 Nace deshabilitado y el Fragment lo habilita cuando los 4 campos están llenos.
                 Usa los mismos selectores de color de "Guardar Cita" (texto blanco bold al habilitarse). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_appointment_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="120dp"
                android:enabled="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/edit_appointment_button"
                android:textAllCaps="false"
                android:textColor="@color/btn_save_text"
                android:textStyle="bold"
                app:backgroundTint="@color/btn_save_tint"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>
    </ScrollView>

    <!-- Círculo de carga: visible solo mientras se guardan los cambios -->
    <ProgressBar
        android:id="@+id/edit_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
