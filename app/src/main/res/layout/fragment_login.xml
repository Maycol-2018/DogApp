<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:paddingStart="16dp"
    android:paddingEnd="0dp"
    tools:context=".view.fragment.LoginFragment">

    <ImageView
        android:id="@+id/dog_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/login_dog_description"
        android:scaleType="fitEnd"
        android:src="@drawable/dog_head"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.72" />

    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/dogapp_display"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textColor="@color/login_title"
        android:textSize="58sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dog_image" />

    <FrameLayout
        android:id="@+id/fingerprint_container"
        android:layout_width="208dp"
        android:layout_height="208dp"
        android:clickable="true"
        android:contentDescription="@string/login_biometric_description"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_marginBottom="88dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fingerprint_animation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_renderMode="software" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
